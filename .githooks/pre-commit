#!/bin/sh
# Git pre-commit hook to prevent direct commits to the main branch

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
    echo ""
    echo "======================================================================"
    echo " [BLOCKED] DIRECT COMMITS TO '$BRANCH' ARE STRICTLY FORBIDDEN BY RULE "
    echo "======================================================================"
    echo " Please create or checkout a feature or fix branch before committing:"
    echo ""
    echo "   git checkout -b feature/<your-feature-name>"
    echo "   git commit -m \"...\""
    echo ""
    echo "======================================================================"
    exit 1
fi

exit 0
